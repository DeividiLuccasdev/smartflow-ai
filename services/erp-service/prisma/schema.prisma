generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Produto {
  id            Int      @id @default(autoincrement())
  nome          String
  sku           String   @unique
  preco         Decimal  @db.Decimal(12, 2)
  estoque       Int      @default(0)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  
  itensPedido ItemPedido[]
}
enum StatusPedido {
  PENDENTE
  CONFIRMADO
  FATURADO
  CANCELADO
}

model Pedido {
  id           Int          @id @default(autoincrement())
  clienteNome  String
  status       StatusPedido @default(PENDENTE)
  valorTotal   Decimal      @default(0) @db.Decimal(12, 2)
  itens        ItemPedido[]
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  oportunidadeId Int?    @unique
  origem         String?
}

model ItemPedido {
  id         Int     @id @default(autoincrement())
  pedidoId   Int
  produtoId  Int
  quantidade Int
  precoUnit  Decimal @db.Decimal(12, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  criadoEm DateTime @default(now())
}

// Outbox transacional: eventos para outros serviços, gravados na mesma
// transação que muda o status do pedido (ver src/lib/outbox.ts).
model EventoOutbox {
  id                 Int       @id @default(autoincrement())
  agregado           String
  tipo               String
  servico            String
  caminho            String
  payload            Json
  tentativas         Int       @default(0)
  proximaTentativaEm DateTime  @default(now())
  bloqueadoAte       DateTime?
  enviadoEm          DateTime?
  falhouEm           DateTime?
  ultimoErro         String?
  criadoEm           DateTime  @default(now())

  @@index([enviadoEm, falhouEm, proximaTentativaEm])
  @@index([agregado])
}

enum StatusChaveIdempotencia {
  EM_ANDAMENTO
  CONCLUIDA
}

// Respostas guardadas por Idempotency-Key (ver src/lib/idempotencia.ts).
model ChaveIdempotencia {
  id             Int                     @id @default(autoincrement())
  usuario        String
  chave          String
  hash           String
  status         StatusChaveIdempotencia @default(EM_ANDAMENTO)
  codigoResposta Int?
  corpoResposta  Json?
  criadoEm       DateTime                @default(now())
  atualizadoEm   DateTime                @updatedAt

  @@unique([usuario, chave])
}
