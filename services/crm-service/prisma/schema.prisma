generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String?  @unique
  telefone      String?
  empresa       String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}
enum StatusLead {
  NOVO
  CONTATO
  QUALIFICADO
  PERDIDO
  CONVERTIDO
}

model Lead {
  id            Int        @id @default(autoincrement())
  nome          String
  email         String?
  telefone      String?
  empresa       String?
  origem        String?
  status        StatusLead @default(NOVO)
  observacoes   String?
  criadoEm      DateTime   @default(now())
  atualizadoEm  DateTime   @updatedAt
}
enum StatusOportunidade {
  ABERTA
  PROPOSTA
  NEGOCIACAO
  GANHA
  PERDIDA
}

model Oportunidade {
  id            Int                @id @default(autoincrement())
  titulo        String
  cliente       String?
  valor         Decimal            @db.Decimal(12, 2)
  status        StatusOportunidade @default(ABERTA)
  responsavel   String?
  observacoes   String?
  // Controle de concorrência otimista: cada alteração incrementa a versão;
  // uma edição baseada em versão antiga recebe 409 em vez de sobrescrever.
  versao        Int                @default(0)
  criadoEm      DateTime           @default(now())
  atualizadoEm  DateTime           @updatedAt
}

// Outbox transacional: eventos para outros serviços, gravados na mesma
// transação que muda o status da oportunidade (ver src/lib/outbox.ts).
model EventoOutbox {
  id                 Int       @id @default(autoincrement())
  agregado           String
  tipo               String
  servico            String
  caminho            String
  payload            Json
  tentativas         Int       @default(0)
  proximaTentativaEm DateTime  @default(now())
  bloqueadoAte       DateTime?
  enviadoEm          DateTime?
  falhouEm           DateTime?
  ultimoErro         String?
  criadoEm           DateTime  @default(now())

  @@index([enviadoEm, falhouEm, proximaTentativaEm])
  @@index([agregado])
}

enum StatusChaveIdempotencia {
  EM_ANDAMENTO
  CONCLUIDA
}

// Respostas guardadas por Idempotency-Key (ver src/lib/idempotencia.ts).
model ChaveIdempotencia {
  id             Int                     @id @default(autoincrement())
  usuario        String
  chave          String
  hash           String
  status         StatusChaveIdempotencia @default(EM_ANDAMENTO)
  codigoResposta Int?
  corpoResposta  Json?
  criadoEm       DateTime                @default(now())
  atualizadoEm   DateTime                @updatedAt

  @@unique([usuario, chave])
}
