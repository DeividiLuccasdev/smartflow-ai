PORT=3005
# Provedor de IA compatível com a OpenAI. Exemplo com o Groq (plano gratuito):
AI_API_KEY=sua_chave_groq_aqui
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Para usar a OpenAI: deixe AI_BASE_URL vazio e use um modelo da OpenAI em AI_MODEL
CRM_SERVICE_URL=http://localhost:3002
ERP_SERVICE_URL=http://localhost:3003
FINANCE_SERVICE_URL=http://localhost:3004

# Mesma chave em todos os serviços e no gateway. Gere com: openssl rand -hex 32
INTERNAL_API_KEY=troque_por_uma_chave_interna_segura
