generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN
  VENDEDOR
  ATENDENTE
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  senhaHash     String
  perfil        Perfil   @default(VENDEDOR)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}